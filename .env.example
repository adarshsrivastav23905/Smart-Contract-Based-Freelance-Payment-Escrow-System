# =============================================================
# Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to GitHub!
# =============================================================

# (Optional) Private key for deploying to a public testnet
# Get test ETH from https://sepoliafaucet.com/
PRIVATE_KEY=your_wallet_private_key_here

# (Optional) Sepolia RPC URL — get a free one from https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here
